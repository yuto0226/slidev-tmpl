{
  "name": "slidev-tmpl",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Personal Slidev themes and decks",
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm fonts:check && node scripts/deck.mjs dev",
    "build": "pnpm fonts:check && node scripts/deck.mjs build",
    "export": "pnpm fonts:check && node scripts/deck.mjs export",
    "site": "pnpm fonts:check && node site/build.mjs",
    "site:index": "node site/build.mjs --index-only",
    "site:check": "node site/check.mjs",
    "site:serve": "pnpm dlx serve dist",
    "fonts": "node scripts/fonts.mjs",
    "fonts:check": "node scripts/fonts.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fit": "node scripts/fit.mjs"
  },
  "devDependencies": {
    "@slidev/parser": "^53.1.0",
    "@slidev/types": "^53.1.0",
    "adm-zip": "^0.6.1",
    "cn-font-split": "^7.4.3",
    "prettier": "^3.10.1",
    "prettier-plugin-slidev": "^1.0.5",
    "smol-toml": "^1.9.1",
    "vue": "^3.5.45"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "cn-font-split",
      "koffi",
      "playwright-chromium",
      "protobufjs"
    ]
  }
}
