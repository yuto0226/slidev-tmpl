{
  "name": "@yuto0226/flourish",
  "version": "1.0.1",
  "type": "module",
  "description": "資安與系統技術的教學、分享與研討會簡報。深色底，內建程式碼、記憶體和堆疊圖等講解用的元件。",
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "license": "MIT AND OFL-1.1",
  "author": "Yuto",
  "homepage": "https://yuto0226.dev/slidev-tmpl/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuto0226/slidev-tmpl.git",
    "directory": "themes/flourish"
  },
  "bugs": "https://github.com/yuto0226/slidev-tmpl/issues",
  "engines": {
    "slidev": ">=53.0.0"
  },
  "files": [
    "components",
    "composables",
    "layouts",
    "lib",
    "setup",
    "styles",
    "custom-nav-controls.vue",
    "global-bottom.vue",
    "slide-top.vue",
    "vite.config.ts",
    "waves.ts",
    "fonts.toml"
  ],
  "scripts": {
    "prepack": "node ../../scripts/fonts.mjs"
  },
  "slidev": {
    "colorSchema": "dark",
    "defaults": {
      "canvasWidth": 960,
      "lineNumbers": true,
      "fonts": {
        "sans": [
          "GenSenRounded TW"
        ],
        "mono": [
          "Maple Mono CN"
        ],
        "provider": "none"
      }
    }
  },
  "dependencies": {
    "@iconify-json/carbon": "^1.2.30",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/ph": "^1.2.2",
    "@shikijs/transformers": "^4.6.0",
    "markdown-it-attrs": "^4.3.1",
    "markdown-it-bracketed-spans": "^1.0.3",
    "markdown-it-github-alerts": "^1.0.1",
    "markdown-it-ins": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "vite": "^8.3.8"
  }
}
